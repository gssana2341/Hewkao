# No VITE_ prefix on purpose — see envPrefix in vite.config.js.
MAPSKEY=your-google-maps-api-key-here

# The live site's origin, no trailing slash (e.g. https://example.com). Used for
# canonical links, Open Graph image URLs and sitemap.xml. Leave empty locally.
VITE_SITE_URL=

# Leave empty to disable analytics (e.g. local dev). Create a free GA4
# property at analytics.google.com to get a Measurement ID (starts with G-).
VITE_GA_MEASUREMENT_ID=

# Fake phone login + instant "purchase" of spin packs (no OTP or payment
# provider yet). Always on in `npm run dev`; leave empty for the public site
# until real OTP and payments exist.
VITE_DEMO_MODE=
